import { afterEach, expect, it, vi } from 'vitest';
import Swal from 'sweetalert2';

afterEach(() => { Swal.close(); vi.useRealTimers(); vi.restoreAllMocks(); vi.unstubAllGlobals(); vi.resetModules(); });

function tab(atLibrary = false) {
  return {
    closed: false,
    location: { href: atLibrary ? 'https://ee.test/library/' : 'about:blank',
      origin: atLibrary ? 'https://ee.test' : 'null', pathname: atLibrary ? '/library/' : 'blank', reload: vi.fn() },
    document: document.implementation.createHTMLDocument(''),
    close: vi.fn(), focus: vi.fn(),
  };
}
function browser(result: ReturnType<typeof tab> | null, opener: ReturnType<typeof tab> | null = null) {
  const open = vi.fn(() => result);
  const assign = vi.fn();
  vi.stubGlobal('window', { open, opener, focus: vi.fn(), location: { href: 'https://ee.test/authors/', assign } });
  return { open, assign };
}

it('reserves once during the click, then opens the saved section without an asynchronous popup', async () => {
  const target = tab();
  const { open } = browser(target);
  const { reserveLibraryReview, LIBRARY_TAB_NAME } = await import('./library-tab');
  const review = reserveLibraryReview(true);
  expect(open).toHaveBeenCalledWith('', LIBRARY_TAB_NAME);
  expect(target.document.body.textContent).toBe('Publishing your ebook…');
  expect(window.focus).toHaveBeenCalledOnce();
  expect(target.document.querySelector('button')).toBeNull();
  review.open('#ee-review=new-book&section=OEBPS/chapter-9.xhtml');
  expect(open).toHaveBeenCalledOnce();
  expect(target.location.href).toBe('/library/#ee-review=new-book&section=OEBPS/chapter-9.xhtml');
  expect(target.location.href).not.toContain('?');
});

it('reuses and reloads the existing Library while leaving Authors open', async () => {
  const existing = tab(true);
  const { open, assign } = browser(null, existing);
  const { reserveLibraryReview, findLibraryTab } = await import('./library-tab');
  const review = reserveLibraryReview(false);
  review.open('#ee-review=new-book&section=OEBPS/old-074.xhtml');
  expect(existing.location.href).toContain('old-074.xhtml');
  expect(existing.location.reload).toHaveBeenCalledOnce();
  expect(existing.focus).toHaveBeenCalledOnce();
  expect(open).not.toHaveBeenCalled();
  expect(assign).not.toHaveBeenCalled();
  expect(findLibraryTab()).toBe(existing);
});

it('uses the same review tab for the ordinary Authors Library button', async () => {
  const target = tab();
  const { open } = browser(target);
  const { reserveLibraryReview, openLibraryTab } = await import('./library-tab');
  reserveLibraryReview(true).open('#ee-review=book');
  Object.assign(target.location, { origin: 'https://ee.test', pathname: '/library/' });
  openLibraryTab();
  expect(open).toHaveBeenCalledOnce();
  expect(target.location.reload).toHaveBeenCalledOnce();
});

it('finds a previously named Library after Authors reloads and loses its window reference', async () => {
  const existing = tab(true);
  const { open } = browser(existing);
  const { reserveLibraryReview, LIBRARY_TAB_NAME } = await import('./library-tab');
  const review = reserveLibraryReview(true);
  expect(open).toHaveBeenCalledWith('', LIBRARY_TAB_NAME);
  review.open('#ee-review=changed-book&section=OEBPS/empty.xhtml');
  expect(existing.location.href).toContain('OEBPS/empty.xhtml');
  expect(existing.location.reload).toHaveBeenCalledOnce();
  expect(existing.document.body.textContent).toBe('');
});

it('closes only the newly reserved empty tab if publication fails', async () => {
  const target = tab();
  browser(target);
  const { reserveLibraryReview } = await import('./library-tab');
  reserveLibraryReview(false).cancel();
  expect(target.close).toHaveBeenCalledOnce();
  const existing = tab(true);
  browser(null, existing);
  reserveLibraryReview(false).cancel();
  expect(existing.close).not.toHaveBeenCalled();
});

it.each([false, true])('still navigates after saving if the review tab is blocked or closed (%s)', async closed => {
  const target = closed ? tab() : null;
  const { assign } = browser(target);
  const { reserveLibraryReview } = await import('./library-tab');
  const review = reserveLibraryReview(true);
  if (target) target.closed = true;
  review.open('#ee-review=book&section=OEBPS/title-page.xhtml');
  expect(assign).toHaveBeenCalledWith('/library/#ee-review=book&section=OEBPS/title-page.xhtml');
});

it.each([false, true])('uses one current confirmation and timer with an existing Library (%s)', async existing => {
  vi.useFakeTimers();
  vi.stubGlobal('matchMedia', vi.fn(() => ({ matches: false, addEventListener: vi.fn(), removeEventListener: vi.fn() })));
  vi.spyOn(window, 'scrollTo').mockImplementation(() => {});
  const target = tab(existing);
  vi.spyOn(window, 'open').mockReturnValue(target as unknown as Window);
  vi.spyOn(window, 'focus').mockImplementation(() => {});
  const { reserveLibraryReview, PUBLISH_CONFIRMATION } = await import('./library-tab');
  const review = reserveLibraryReview(true);
  const fire = vi.spyOn(Swal, 'fire');
  const popup = review.confirmPublished();
  await vi.advanceTimersByTimeAsync(50);
  expect(Swal.getTitle()?.textContent).toBe(PUBLISH_CONFIRMATION);
  expect(Swal.getConfirmButton()?.style.display).toBe('none');
  if (!existing) {
    expect(target.document.querySelector('.swal2-title')?.textContent).toBe(PUBLISH_CONFIRMATION);
    expect(target.document.querySelector('.swal2-success')).not.toBeNull();
    expect(target.document.querySelector<HTMLButtonElement>('.swal2-confirm')?.style.display).toBe('none');
    expect(target.document.querySelector('link[rel="stylesheet"]')).toBeNull();
    expect(target.document.head.querySelector('style')?.textContent).toContain('.swal2-popup');
    expect(target.document.querySelector('.swal2-popup')?.outerHTML).toBe(Swal.getPopup()?.outerHTML);
  }
  await vi.advanceTimersByTimeAsync(3000);
  expect((await popup).dismiss).toBe('timer');
  review.open('#ee-review=book&section=OEBPS/empty.xhtml');
  expect(fire).toHaveBeenCalledOnce();
  expect(target.location.href).toBe('/library/#ee-review=book&section=OEBPS/empty.xhtml');
});
